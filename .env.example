# Cycle 23: ローカル試運転用の設定例。
# このファイルをコピーして .env を作成し、パスワードだけを自分で決めた値へ変更してください。
#
#   copy .env.example .env      (Windows)
#
# 重要:
# - .env はGit管理外です（コミットしないでください）。
# - ここに書く値は Docker 内の試運転用DB専用です。
#   ホストPCにある本物のMySQLのパスワードは絶対に書かないでください。
# - 下のパスワードは「例示のダミー値」です。必ず別の値へ変更してください。

# アプリを開くポート（http://localhost:18080 でアクセスします）
APP_PORT=18080

# Docker内の試運転用DB（ホストの本物DBとは別物です）
MYSQL_DATABASE=budget_pilot
MYSQL_USER=pilot_user

# ↓↓↓ 必ず自分で決めた値へ変更してください（本物DBのパスワードは使わない）↓↓↓
MYSQL_PASSWORD=change-me-pilot-password
MYSQL_ROOT_PASSWORD=change-me-pilot-root-password
